{
  "expo": {
    "name": "Deltom",
    "slug": "deltom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deltom",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3A3A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.deltom.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Deltom a besoin de la caméra pour prendre des photos d'intervention.",
        "NSPhotoLibraryUsageDescription": "Deltom a besoin d'accéder à vos photos pour les interventions.",
        "NSLocationWhenInUseUsageDescription": "Deltom utilise votre position pour les missions proches de vous."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A3A3A"
      },
      "package": "fr.deltom.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1A3A3A"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
